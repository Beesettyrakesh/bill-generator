# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and must never be committed.

# ─── NextAuth ──────────────────────────────────────────────────────────────
# Public base URL of the app (e.g. https://yourappname.vercel.app in production)
NEXTAUTH_URL=http://localhost:3000
# Secret used to sign/encrypt session JWTs.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── MongoDB (authentication / user store) ────────────────────────────────
# Full connection string including the database name (bill-generator).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/dbname?retryWrites=true&w=majority

# ─── AWS credentials (DynamoDB access) ─────────────────────────────────────
# Prefer an IAM user scoped only to the four DynamoDB tables below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ─── AWS DynamoDB table names ──────────────────────────────────────────────
DYNAMODB_BILLS_TABLE=
DYNAMODB_DEMO_BILLS_TABLE=
DYNAMODB_BRANCH_CONFIG_TABLE=
DYNAMODB_COMPANY_CONFIG_TABLE=

# ─── CloudConvert (DOCX → PDF conversion) ──────────────────────────────────
# Create an API key at: https://cloudconvert.com/dashboard/api/v2/keys
CLOUDCONVERT_API_KEY=
